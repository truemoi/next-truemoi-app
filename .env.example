# ── Truemoi example app configuration ────────────────────────────────
# Copy to .env.local and adjust. NEXT_PUBLIC_* values are baked into the
# client bundle at BUILD time — after changing them, restart `next dev`
# or rebuild for `next start` to pick them up.

# The auth (IdP) domain. Bare host or full URL. Default: auth.truemoi.com
NEXT_PUBLIC_AUTH_DOMAIN=auth.truemoi.com

# The public OAuth client_id of THIS app, as registered in the platform
# (see scripts/register-client.sh). Default example client: truemoi-example
NEXT_PUBLIC_AUTH_CLIENT_ID=truemoi-example

# Keycloak realm to authenticate against. Default: truemoi
NEXT_PUBLIC_AUTH_REALM=truemoi

# The platform API the browser + server talk to for token exchange,
# /me, refresh and verification data.
# Local stack: http://localhost:4001 — production: https://api.truemoi.com
NEXT_PUBLIC_OAUTH_API_URL=http://localhost:4001

# This app's public origin. Used for redirect/post-logout URLs when the
# request origin isn't enough (e.g. behind a proxy). Leave empty to
# derive from the incoming request.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side only. Verify API key (from the platform console) used by
# @truemoi/sdk server-side identity checks. Optional — /me already
# returns verification status for the signed-in user.
VERIFY_API_KEY=
